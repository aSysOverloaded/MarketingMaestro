# Copy this file to .env and fill in real values. .env is gitignored.
# Loaded via app/config.py (pydantic-settings) from this directory. Real env vars take precedence.

# --- Primary chat provider: every AI step (profile, extraction, ranking, planner, writer,
#     critic, evaluator). Any OpenAI-compatible endpoint works, so switching vendor is a
#     config change. Gemini's free tier is used below; its OpenAI-compatible base URL is:
#     https://generativelanguage.googleapis.com/v1beta/openai/
#     OpenRouter is https://openrouter.ai/api/v1 ---
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Optional: a stronger model for the spec critic only (fact-checking the copy). Empty = LLM_MODEL.
LLM_CRITIC_MODEL=

# --- Backup provider. A call that fails on the primary provider (free tiers are regularly
#     overloaded (503) or capped (429)) is retried once here. Use a different vendor, so both
#     rarely fail at once. Leave empty to disable. ---
LLM_FALLBACK_API_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=nex-agi/nex-n2.5-pro:free

# --- Embeddings only (app/rag/search.py) - OpenRouter has no embeddings endpoint. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Optional SMTP for the "Send" button. Unset = emails are logged to storage/sent_emails. ---
# Port 465 uses implicit TLS; any other port uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional: skip PDF rendering (no browser available). Runs then return pdf_url=null. ---
DISABLE_PDF=false
