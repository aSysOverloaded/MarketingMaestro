# Copy this file to .env and fill in real values. .env is gitignored.
# Loaded via app/config.py (pydantic-settings) from this directory. Real env vars take precedence.

# --- Chat model for every AI step (profile, extraction, ranking, planner, writer, critic,
#     evaluator). Any OpenAI-compatible endpoint works. ---
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Embeddings only (app/rag/search.py) - OpenRouter has no embeddings endpoint. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Optional SMTP for the "Send" button. Unset = emails are logged to storage/sent_emails. ---
# Port 465 uses implicit TLS; any other port uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional: skip PDF rendering (no browser available). Runs then return pdf_url=null. ---
DISABLE_PDF=false
