# Copy this file to .env and fill in real values. .env is gitignored.
# Loaded via app/config.py (pydantic-settings) from this directory - the sidecar's own
# working directory, separate from backend-go/.env. Real env vars still take precedence.

# --- Embeddings only (app/rag/search.py) - OpenRouter has no embeddings endpoint,
#     so this is the one call that can't move off Gemini. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Chat steps: planner/writer/critic/evaluator. Names mirror backend-go/.env -
#     same mental model, but this is a separate process/file, so the key must be
#     pasted in here too even if it's already set on the Go side. ---
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
