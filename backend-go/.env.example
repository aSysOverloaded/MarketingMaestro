# Copy this file to .env and fill in real values. .env is gitignored.

# --- Generation LLM (Go backend: UserProfileStep, ProductRecommenderStep) ---
# Option A: OpenRouter (or any OpenAI-compatible API) - checked first if set.
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.7:free

# Option B: Native Gemini - only used if LLM_API_URL/LLM_API_KEY are empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Python sidecar location ---
PYTHON_SERVICE_URL=http://localhost:8001

# --- Optional: SMTP for real email dispatch (falls back to a local .log file if unset) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Optional: force the PDF mock fallback instead of launching Chrome/Edge ---
DISABLE_CHROME_PDF=false
